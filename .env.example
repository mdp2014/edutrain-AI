# GEMINI_API_KEY: Required for Gemini AI API calls (server-side secret).
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Supabase public browser configuration (enforced by PostgreSQL RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase server-side configuration (keep SERVICE_ROLE_KEY strictly server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
